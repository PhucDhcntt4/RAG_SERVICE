# Copy this file to .env, then fill in your own credentials.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/RAG_SERVICE

# Generate TWO different keys, one per command execution:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SEARCH_API_KEY=
ADMIN_API_KEY=
GEMINI_API_KEY=

RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.45
RAG_MAX_CONTEXT_CHARS=6000
# Chunk size/overlap are measured in characters.
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_MAX_DOCUMENT_CHARS=200000
RAG_MAX_CHUNKS=300
RAG_MAX_UPLOAD_BYTES=10485760
RAG_MAX_CONCURRENT_REQUESTS=2
RAG_EMBEDDING_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
