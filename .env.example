# Required API credentials. Generate two different internal keys with at least
# 32 ASCII characters; never commit real secrets.
SEARCH_API_KEY=replace-with-search-key-at-least-32-characters
ADMIN_API_KEY=replace-with-admin-key-at-least-32-characters
GEMINI_API_KEY=replace-with-gemini-api-key

# Qdrant knowledge collection
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_service_compare_v1
QDRANT_TIMEOUT_SECONDS=15

# PostgreSQL taxonomy and Product Sync metadata
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/RAG_SERVICE

# RAG retrieval and generation
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_CHAT_MODEL=gemini-3.1-flash-lite
RAG_TOP_K=5
RAG_HYBRID_ENABLED=true
RAG_HYBRID_CANDIDATES=20
RAG_RRF_K=60
RAG_MIN_SIMILARITY=0.45
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_CONCURRENT_REQUESTS=2
RAG_LOCAL_ADMIN_ENABLED=true
RAG_CHUNKING_STRATEGY=adaptive
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_SEMANTIC_MIN_CHARS=300
RAG_SEMANTIC_BREAKPOINT_PERCENTILE=80
RAG_MAX_DOCUMENT_CHARS=200000
RAG_MAX_CHUNKS=300
RAG_MAX_UPLOAD_BYTES=10485760
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_BATCH_INTERVAL_SECONDS=0
RAG_EMBEDDING_MAX_RETRIES=0
RAG_CHAT_TIMEOUT_SECONDS=60
RAG_CHAT_MAX_STATEMENTS=40
RAG_CHAT_MAX_ANSWER_CHARS=12000
RAG_OVERVIEW_MAX_DOCUMENTS=3
RAG_OVERVIEW_MAX_CHUNKS=100
LOG_LEVEL=INFO

# Product catalog and Shopify synchronization
PRODUCT_CATALOG_COLLECTION=bot_product_catalog_v1
PRODUCT_IMAGE_COLLECTION=bot_product_images_clip_v2
SHOP=your-shop.myshopify.com
SHOPIFY_TOKEN=replace-with-shopify-admin-api-token
SHOPIFY_API_VERSION=2026-01
PRODUCT_SYNC_WRITE_ENABLED=false
PRODUCT_SYNC_POLL_SECONDS=5
PRODUCT_CLIP_DEVICE=auto
PRODUCT_IMAGE_STORAGE_DIR=storage/product_images
PRODUCT_IMAGE_MAX_BYTES=20971520
INVENTORY_SYNC_ENABLED=false
INVENTORY_SYNC_INTERVAL_HOURS=6

# Docker Compose values
POSTGRES_DB=rag_service
POSTGRES_USER=rag_service
POSTGRES_PASSWORD=replace-with-strong-postgres-password
RAG_HTTP_PORT=8000
